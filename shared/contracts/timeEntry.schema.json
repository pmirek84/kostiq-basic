{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kostiq.pl/schemas/time-entry.json",
  "title": "TimeEntryContracts",
  "description": "Canonical domain contract and JSON Schemas for TimeEntry, statuses, and API payloads.",
  "definitions": {
    "TimeEntryStatus": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "submitted",
        "approved",
        "rejected",
        "foreman_approved",
        "foreman_rejected",
        "admin_approved",
        "admin_rejected"
      ]
    },
    "WorkerAllowedStatus": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "submitted"
      ]
    },
    "ForemanAllowedStatus": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "submitted",
        "foreman_approved",
        "foreman_rejected"
      ]
    },
    "BillingType": {
      "type": "string",
      "enum": [
        "hourly",
        "daily",
        "project",
        "fixed",
        "m2",
        "mb"
      ]
    },
    "TimeEntryType": {
      "type": "string",
      "enum": [
        "drive",
        "work",
        "other",
        "employee",
        "subcontractor"
      ]
    },
    "TimeEntry": {
      "type": "object",
      "required": [
        "id",
        "employeeId",
        "jobId",
        "jobCode",
        "jobName",
        "stageId",
        "stageName",
        "date",
        "hours",
        "billingType",
        "cost",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "employeeId": {
          "type": "string",
          "minLength": 1
        },
        "employeeName": {
          "type": "string"
        },
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "jobCode": {
          "type": "string"
        },
        "jobName": {
          "type": "string"
        },
        "stageId": {
          "type": "string"
        },
        "stageName": {
          "type": "string"
        },
        "date": {
          "$ref": "#/definitions/DateString"
        },
        "hours": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "billingType": {
          "$ref": "#/definitions/BillingType"
        },
        "hourlyRate": {
          "type": "number",
          "minimum": 0
        },
        "cost": {
          "type": "number",
          "minimum": 0
        },
        "description": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/TimeEntryStatus"
        },
        "crewId": {
          "type": [
            "string",
            "null"
          ]
        },
        "foremanId": {
          "type": [
            "string",
            "null"
          ]
        },
        "foremanApprovedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "adminId": {
          "type": [
            "string",
            "null"
          ]
        },
        "adminApprovedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "settlementId": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "$ref": "#/definitions/TimeEntryType"
        },
        "workType": {
          "type": "string"
        },
        "quantity": {
          "type": "number"
        },
        "rate": {
          "type": "number"
        },
        "approved": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "activityType": {
          "$ref": "#/definitions/ActivityType"
        },
        "workerType": {
          "$ref": "#/definitions/WorkerType"
        }
      },
      "additionalProperties": true
    },
    "TimeEntryPostBase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "jobCode": {
          "type": "string"
        },
        "jobName": {
          "type": "string"
        },
        "stageId": {
          "type": "string"
        },
        "stageName": {
          "type": "string"
        },
        "date": {
          "$ref": "#/definitions/DateString"
        },
        "hours": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "billingType": {
          "$ref": "#/definitions/BillingType"
        },
        "hourlyRate": {
          "type": "number",
          "minimum": 0
        },
        "cost": {
          "type": "number",
          "minimum": 0
        },
        "description": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/TimeEntryStatus"
        },
        "crewId": {
          "type": [
            "string",
            "null"
          ]
        },
        "foremanId": {
          "type": [
            "string",
            "null"
          ]
        },
        "foremanApprovedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "adminId": {
          "type": [
            "string",
            "null"
          ]
        },
        "adminApprovedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "settlementId": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "$ref": "#/definitions/TimeEntryType"
        },
        "workType": {
          "type": "string"
        },
        "quantity": {
          "type": "number"
        },
        "rate": {
          "type": "number"
        },
        "activityType": {
          "$ref": "#/definitions/ActivityType"
        },
        "workerType": {
          "$ref": "#/definitions/WorkerType"
        }
      },
      "additionalProperties": true
    },
    "CanonicalTimeEntryPostPayload": {
      "allOf": [
        {
          "$ref": "#/definitions/TimeEntryPostBase"
        }
      ],
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "minLength": 1
        },
        "jobId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "employeeId",
        "jobId"
      ],
      "additionalProperties": true
    },
    "TimeEntryPostPayload": {
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "#/definitions/TimeEntryPostBase"
            }
          ],
          "type": "object",
          "properties": {
            "employeeId": {
              "type": "string",
              "minLength": 1
            },
            "jobId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "employeeId",
            "jobId"
          ],
          "additionalProperties": true
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/TimeEntryPostBase"
            }
          ],
          "type": "object",
          "properties": {
            "employee_id": {
              "type": "string",
              "minLength": 1
            },
            "jobId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "employee_id",
            "jobId"
          ],
          "additionalProperties": true
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/TimeEntryPostBase"
            }
          ],
          "type": "object",
          "properties": {
            "employeeId": {
              "type": "string",
              "minLength": 1
            },
            "project_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "employeeId",
            "project_id"
          ],
          "additionalProperties": true
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/TimeEntryPostBase"
            }
          ],
          "type": "object",
          "properties": {
            "employee_id": {
              "type": "string",
              "minLength": 1
            },
            "project_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "employee_id",
            "project_id"
          ],
          "additionalProperties": true
        }
      ]
    },
    "TimeEntryPatchPayload": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "employeeId": {
          "type": "string",
          "minLength": 1
        },
        "employee_id": {
          "type": "string",
          "minLength": 1
        },
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "jobCode": {
          "type": "string"
        },
        "jobName": {
          "type": "string"
        },
        "stageId": {
          "type": "string"
        },
        "stageName": {
          "type": "string"
        },
        "date": {
          "$ref": "#/definitions/DateString"
        },
        "hours": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "billingType": {
          "$ref": "#/definitions/BillingType"
        },
        "hourlyRate": {
          "type": "number",
          "minimum": 0
        },
        "cost": {
          "type": "number",
          "minimum": 0
        },
        "description": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/TimeEntryStatus"
        },
        "crewId": {
          "type": [
            "string",
            "null"
          ]
        },
        "foremanId": {
          "type": [
            "string",
            "null"
          ]
        },
        "foremanApprovedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "adminId": {
          "type": [
            "string",
            "null"
          ]
        },
        "adminApprovedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "settlementId": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "$ref": "#/definitions/TimeEntryType"
        },
        "workType": {
          "type": "string"
        },
        "quantity": {
          "type": "number"
        },
        "rate": {
          "type": "number"
        },
        "_lastUpdatedAt": {
          "type": "string"
        },
        "activityType": {
          "$ref": "#/definitions/ActivityType"
        },
        "workerType": {
          "$ref": "#/definitions/WorkerType"
        }
      },
      "additionalProperties": true
    },
    "TimeEntryBatchImportPayload": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TimeEntryPostPayload"
          }
        }
      },
      "additionalProperties": true
    },
    "TimeEntryBatchImportResult": {
      "type": "object",
      "required": [
        "status",
        "succeeded",
        "failed",
        "succeededIds",
        "failedIds",
        "errors"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "success",
            "partial_success",
            "failed"
          ]
        },
        "succeeded": {
          "type": "integer",
          "minimum": 0
        },
        "upserted": {
          "type": "integer",
          "minimum": 0
        },
        "modified": {
          "type": "integer",
          "minimum": 0
        },
        "matched": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "succeededIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failedIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "ActivityType": {
      "type": "string",
      "enum": [
        "drive",
        "work",
        "other"
      ]
    },
    "WorkerType": {
      "type": "string",
      "enum": [
        "employee",
        "subcontractor"
      ]
    },
    "DateString": {
      "type": "string",
      "format": "kostiq-date-string",
      "description": "Calendar date (YYYY-MM-DD) or ISO 8601 timestamp (YYYY-MM-DDTHH:mm:ss.sssZ).",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}(T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?(?:Z|[+-](?:[01]\\d|2[0-3]):?[0-5]\\d)?)?$"
    }
  }
}
