{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "invoice",
  "title": "InvoiceSchema",
  "type": "object",
  "definitions": {
    "CalendarDate": {
      "type": "string",
      "format": "kostiq-calendar-date",
      "description": "Calendar date in YYYY-MM-DD format.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "NullableCalendarDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "kostiq-calendar-date",
      "description": "Nullable calendar date in YYYY-MM-DD format.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "InstantString": {
      "type": "string",
      "format": "kostiq-instant-string",
      "description": "ISO 8601 instant timestamp with mandatory timezone (e.g. 2026-10-04T12:00:00.000Z or +02:00).",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?(?:Z|[+-](?:[01]\\d|2[0-3]):?[0-5]\\d)$"
    },
    "NullableInstantString": {
      "type": [
        "string",
        "null"
      ],
      "format": "kostiq-instant-string",
      "description": "Nullable ISO 8601 instant timestamp with mandatory timezone.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?(?:Z|[+-](?:[01]\\d|2[0-3]):?[0-5]\\d)$"
    },
    "InvoiceDocumentStatus": {
      "type": "string",
      "enum": [
        "draft",
        "issued",
        "cancelled"
      ],
      "description": "Lifecycle of the legal/tax document."
    },
    "InvoiceImportDocumentStatus": {
      "type": "string",
      "enum": [
        "issued",
        "cancelled"
      ],
      "description": "Lifecycle of historical imported document (drafts cannot be imported with issued numbers)."
    },
    "InvoicePaymentStatus": {
      "type": "string",
      "enum": [
        "unpaid",
        "partial",
        "paid"
      ],
      "description": "Stored financial settlement status (overdue is computed dynamically)."
    },
    "InvoiceVatRate": {
      "type": "integer",
      "enum": [
        0,
        5,
        8,
        23
      ],
      "description": "Standard Polish VAT tax rates."
    },
    "InvoiceCurrency": {
      "type": "string",
      "enum": [
        "PLN"
      ],
      "default": "PLN"
    },
    "InvoicePaymentMethod": {
      "type": "string",
      "enum": [
        "transfer",
        "cash",
        "card",
        "blik",
        "other"
      ]
    },
    "InvoicePaymentType": {
      "type": "string",
      "enum": [
        "payment",
        "refund"
      ]
    },
    "InvoiceLineItemInput": {
      "type": "object",
      "required": [
        "description",
        "quantity",
        "unitNetMinor",
        "vatRate"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string"
        },
        "unitNetMinor": {
          "type": "integer",
          "minimum": 0
        },
        "vatRate": {
          "$ref": "#/definitions/InvoiceVatRate"
        }
      }
    },
    "InvoiceLineItem": {
      "type": "object",
      "required": [
        "description",
        "quantity",
        "unitNetMinor",
        "vatRate",
        "amountNetMinor",
        "vatAmountMinor",
        "amountGrossMinor"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string"
        },
        "unitNetMinor": {
          "type": "integer",
          "minimum": 0
        },
        "vatRate": {
          "$ref": "#/definitions/InvoiceVatRate"
        },
        "amountNetMinor": {
          "type": "integer",
          "minimum": 0
        },
        "vatAmountMinor": {
          "type": "integer",
          "minimum": 0
        },
        "amountGrossMinor": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "InvoicePaymentDocument": {
      "type": "object",
      "required": [
        "id",
        "invoiceId",
        "jobId",
        "type",
        "amountMinor",
        "currency",
        "paymentDate",
        "paymentMethod",
        "sequence",
        "createdAt"
      ],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "type": [
            "string",
            "object"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "invoiceId": {
          "type": "string",
          "minLength": 1
        },
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/definitions/InvoicePaymentType"
        },
        "amountMinor": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "$ref": "#/definitions/InvoiceCurrency"
        },
        "paymentDate": {
          "$ref": "#/definitions/CalendarDate"
        },
        "paymentMethod": {
          "$ref": "#/definitions/InvoicePaymentMethod"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "reversesPaymentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "idempotencyKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "operationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "recordedBy": {
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/definitions/InstantString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "refund"
              }
            }
          },
          "then": {
            "required": [
              "reversesPaymentId"
            ],
            "properties": {
              "reversesPaymentId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "InvoiceDocument": {
      "type": "object",
      "required": [
        "id",
        "jobId",
        "documentStatus",
        "paymentStatus",
        "amountNetMinor",
        "vatAmountMinor",
        "amountGrossMinor",
        "paidAmountMinor",
        "remainingAmountMinor",
        "currency",
        "createdAt",
        "updatedAt",
        "editVersion",
        "isActive"
      ],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "type": [
            "string",
            "object"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "clientId": {
          "type": [
            "string",
            "null"
          ]
        },
        "invoiceNumber": {
          "type": [
            "string",
            "null"
          ]
        },
        "documentStatus": {
          "$ref": "#/definitions/InvoiceDocumentStatus"
        },
        "paymentStatus": {
          "$ref": "#/definitions/InvoicePaymentStatus"
        },
        "amountNetMinor": {
          "type": "integer",
          "minimum": 0
        },
        "vatRate": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            0,
            5,
            8,
            23,
            null
          ]
        },
        "vatAmountMinor": {
          "type": "integer",
          "minimum": 0
        },
        "amountGrossMinor": {
          "type": "integer",
          "minimum": 0
        },
        "paidAmountMinor": {
          "type": "integer",
          "minimum": 0
        },
        "remainingAmountMinor": {
          "type": "integer",
          "minimum": 0
        },
        "amountNet": {
          "type": "number",
          "minimum": 0,
          "description": "Legacy decimal PLN amount (amountNetMinor / 100)"
        },
        "vatAmount": {
          "type": "number",
          "minimum": 0
        },
        "amountGross": {
          "type": "number",
          "minimum": 0
        },
        "paidAmount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "$ref": "#/definitions/InvoiceCurrency"
        },
        "issueDate": {
          "$ref": "#/definitions/NullableCalendarDate"
        },
        "dueDate": {
          "$ref": "#/definitions/NullableCalendarDate"
        },
        "paidDate": {
          "$ref": "#/definitions/NullableCalendarDate"
        },
        "cancellationDate": {
          "$ref": "#/definitions/NullableCalendarDate"
        },
        "cancelledAt": {
          "$ref": "#/definitions/NullableInstantString"
        },
        "cancelReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InvoiceLineItem"
          }
        },
        "createdAt": {
          "$ref": "#/definitions/InstantString"
        },
        "updatedAt": {
          "$ref": "#/definitions/InstantString"
        },
        "editVersion": {
          "type": "integer",
          "minimum": 1
        },
        "isActive": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "documentStatus": {
                "const": "draft"
              }
            }
          },
          "then": {
            "properties": {
              "invoiceNumber": {
                "type": "null"
              },
              "issueDate": {
                "type": "null"
              },
              "cancelledAt": {
                "type": "null"
              },
              "cancelReason": {
                "type": "null"
              },
              "paymentStatus": {
                "const": "unpaid"
              },
              "paidAmountMinor": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "documentStatus": {
                "const": "issued"
              }
            }
          },
          "then": {
            "required": [
              "invoiceNumber",
              "issueDate"
            ],
            "properties": {
              "invoiceNumber": {
                "type": "string",
                "pattern": "^FV/\\d{4}/\\d{3,}$"
              },
              "issueDate": {
                "$ref": "#/definitions/CalendarDate"
              },
              "cancelledAt": {
                "type": "null"
              },
              "cancelReason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "documentStatus": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "required": [
              "invoiceNumber",
              "issueDate",
              "cancelledAt",
              "cancelReason"
            ],
            "properties": {
              "invoiceNumber": {
                "type": "string",
                "pattern": "^FV/\\d{4}/\\d{3,}$"
              },
              "issueDate": {
                "$ref": "#/definitions/CalendarDate"
              },
              "cancelledAt": {
                "$ref": "#/definitions/InstantString"
              },
              "cancelReason": {
                "type": "string",
                "minLength": 1
              },
              "paidAmountMinor": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "paymentStatus": {
                "const": "unpaid"
              }
            }
          },
          "then": {
            "properties": {
              "paidAmountMinor": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "paymentStatus": {
                "const": "paid"
              }
            }
          },
          "then": {
            "properties": {
              "paidAmountMinor": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "paymentStatus": {
                "const": "partial"
              }
            }
          },
          "then": {
            "properties": {
              "paidAmountMinor": {
                "minimum": 1
              }
            }
          }
        }
      ],
      "oneOf": [
        {
          "title": "SimplifiedInvoiceDocument",
          "description": "Simplified invoice without line items: requires single header vatRate",
          "required": [
            "vatRate"
          ],
          "properties": {
            "vatRate": {
              "$ref": "#/definitions/InvoiceVatRate"
            },
            "items": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        {
          "title": "ItemizedInvoiceDocument",
          "description": "Itemized invoice with line items: header vatRate must be null and VAT comes from items",
          "required": [
            "items",
            "vatRate"
          ],
          "properties": {
            "vatRate": {
              "type": "null"
            },
            "items": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      ]
    },
    "InvoicePostPayload": {
      "type": "object",
      "required": [
        "jobId"
      ],
      "additionalProperties": false,
      "properties": {
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "clientId": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "$ref": "#/definitions/InvoiceCurrency"
        },
        "dueDate": {
          "$ref": "#/definitions/CalendarDate"
        },
        "description": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "amountNetMinor": {
          "type": "integer",
          "minimum": 0
        },
        "vatRate": {
          "$ref": "#/definitions/InvoiceVatRate"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InvoiceLineItemInput"
          }
        }
      },
      "oneOf": [
        {
          "title": "SimplifiedInvoice",
          "description": "Simplified invoice with header net amount and vat rate, without line items",
          "required": [
            "amountNetMinor",
            "vatRate"
          ],
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        {
          "title": "ItemizedInvoice",
          "description": "Itemized invoice with line items, where totals are backend-calculated",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "amountNetMinor"
                ]
              },
              {
                "required": [
                  "vatRate"
                ]
              }
            ]
          }
        }
      ]
    },
    "InvoiceIssuePayload": {
      "type": "object",
      "required": [
        "expectedVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "expectedVersion": {
          "type": "integer",
          "minimum": 1
        },
        "issueDate": {
          "$ref": "#/definitions/CalendarDate",
          "description": "Validated issue date in Europe/Warsaw (defaults to today in Warsaw if omitted)"
        },
        "dueDate": {
          "$ref": "#/definitions/CalendarDate"
        }
      }
    },
    "InvoicePaymentPayload": {
      "type": "object",
      "required": [
        "expectedVersion",
        "amountMinor",
        "paymentMethod"
      ],
      "additionalProperties": false,
      "properties": {
        "expectedVersion": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "$ref": "#/definitions/InvoicePaymentType",
          "default": "payment"
        },
        "amountMinor": {
          "type": "integer",
          "minimum": 1
        },
        "paymentMethod": {
          "$ref": "#/definitions/InvoicePaymentMethod"
        },
        "paymentDate": {
          "$ref": "#/definitions/CalendarDate"
        },
        "reversesPaymentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "refund"
              }
            }
          },
          "then": {
            "required": [
              "reversesPaymentId"
            ],
            "properties": {
              "reversesPaymentId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "InvoiceCancelPayload": {
      "type": "object",
      "required": [
        "expectedVersion",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "expectedVersion": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "cancellationDate": {
          "$ref": "#/definitions/CalendarDate"
        }
      }
    },
    "InvoicePatchPayload": {
      "type": "object",
      "required": [
        "expectedVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "expectedVersion": {
          "type": "integer",
          "minimum": 1
        },
        "clientId": {
          "type": [
            "string",
            "null"
          ]
        },
        "dueDate": {
          "$ref": "#/definitions/CalendarDate"
        },
        "description": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "amountNetMinor": {
          "type": "integer",
          "minimum": 0
        },
        "vatRate": {
          "$ref": "#/definitions/InvoiceVatRate"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InvoiceLineItemInput"
          }
        }
      },
      "oneOf": [
        {
          "title": "MetadataOnlyPatch",
          "description": "Patch without changing amounts or items, requires at least one mutable field",
          "anyOf": [
            {
              "required": [
                "clientId"
              ]
            },
            {
              "required": [
                "dueDate"
              ]
            },
            {
              "required": [
                "description"
              ]
            },
            {
              "required": [
                "notes"
              ]
            }
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "amountNetMinor"
                ]
              },
              {
                "required": [
                  "vatRate"
                ]
              },
              {
                "required": [
                  "items"
                ]
              }
            ]
          }
        },
        {
          "title": "SimplifiedPatch",
          "description": "Patch amounts with header net and vat rate",
          "required": [
            "amountNetMinor",
            "vatRate"
          ],
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        {
          "title": "ItemizedPatch",
          "description": "Patch amounts with line items",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "amountNetMinor"
                ]
              },
              {
                "required": [
                  "vatRate"
                ]
              }
            ]
          }
        }
      ]
    },
    "InvoiceBatchImportPaymentItem": {
      "type": "object",
      "required": [
        "id",
        "type",
        "amountMinor",
        "paymentDate",
        "paymentMethod",
        "sequence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/definitions/InvoicePaymentType"
        },
        "amountMinor": {
          "type": "integer",
          "minimum": 1
        },
        "paymentDate": {
          "$ref": "#/definitions/CalendarDate"
        },
        "paymentMethod": {
          "$ref": "#/definitions/InvoicePaymentMethod"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "reversesPaymentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "operationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "refund"
              }
            }
          },
          "then": {
            "required": [
              "reversesPaymentId"
            ],
            "properties": {
              "reversesPaymentId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "InvoiceBatchImportItem": {
      "type": "object",
      "required": [
        "id",
        "jobId",
        "invoiceNumber",
        "documentStatus",
        "issueDate"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "clientId": {
          "type": [
            "string",
            "null"
          ]
        },
        "invoiceNumber": {
          "type": "string",
          "pattern": "^FV/\\d{4}/\\d{3,}$"
        },
        "documentStatus": {
          "$ref": "#/definitions/InvoiceImportDocumentStatus"
        },
        "currency": {
          "$ref": "#/definitions/InvoiceCurrency"
        },
        "issueDate": {
          "$ref": "#/definitions/CalendarDate"
        },
        "dueDate": {
          "$ref": "#/definitions/NullableCalendarDate"
        },
        "cancellationDate": {
          "$ref": "#/definitions/NullableCalendarDate"
        },
        "cancelledAt": {
          "$ref": "#/definitions/NullableInstantString"
        },
        "cancelReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "amountNetMinor": {
          "type": "integer",
          "minimum": 0
        },
        "vatRate": {
          "$ref": "#/definitions/InvoiceVatRate"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InvoiceLineItemInput"
          }
        },
        "payments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InvoiceBatchImportPaymentItem"
          }
        },
        "createdAt": {
          "$ref": "#/definitions/NullableInstantString"
        },
        "updatedAt": {
          "$ref": "#/definitions/NullableInstantString"
        },
        "editVersion": {
          "type": "integer",
          "minimum": 1
        },
        "isActive": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "documentStatus": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "required": [
              "invoiceNumber",
              "issueDate",
              "cancelledAt",
              "cancelReason"
            ],
            "properties": {
              "invoiceNumber": {
                "type": "string",
                "pattern": "^FV/\\d{4}/\\d{3,}$"
              },
              "issueDate": {
                "$ref": "#/definitions/CalendarDate"
              },
              "cancelledAt": {
                "$ref": "#/definitions/InstantString"
              },
              "cancelReason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "documentStatus": {
                "const": "issued"
              }
            }
          },
          "then": {
            "properties": {
              "cancelledAt": {
                "type": "null"
              },
              "cancelReason": {
                "type": "null"
              }
            }
          }
        }
      ],
      "oneOf": [
        {
          "title": "SimplifiedImportItem",
          "required": [
            "amountNetMinor",
            "vatRate"
          ],
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        {
          "title": "ItemizedImportItem",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "amountNetMinor"
                ]
              },
              {
                "required": [
                  "vatRate"
                ]
              }
            ]
          }
        }
      ]
    },
    "InvoiceBatchImportPayload": {
      "type": "object",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/InvoiceBatchImportItem"
          }
        }
      }
    }
  }
}
