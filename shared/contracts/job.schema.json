      "type": "object",
      "required": [
        "name",
        "clientId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "jobCode": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "clientId": {
          "type": "string",
          "minLength": 1
        },
        "clientName": {
          "type": "string"
        },
        "offerId": {
          "type": "string"
        },
        "offerNumber": {
          "type": "string"
