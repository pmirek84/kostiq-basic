        },
        "plannedRevenueNet": {
          "type": "number",
          "minimum": 0
        },
        "plannedCostNet": {
          "type": "number",
          "minimum": 0
        },
        "revenueSharePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
