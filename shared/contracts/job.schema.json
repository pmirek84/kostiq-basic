{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JobContractSchema",
  "description": "Unified JSON schema for Job domain entity, POST/PATCH payloads, batch imports, stage lifecycle, and paginated responses.",
  "definitions": {
    "JobStatus": {
      "type": "string",
      "enum": [
        "draft",
        "planned",
        "in_progress",
        "paused",
        "done",
        "cancelled"
      ]
    },
    "JobStageStatus": {
      "type": "string",
      "enum": [
        "planowany",
        "w_toku",
        "zakończony",
        "anulowany"
      ]
    },
    "JobStageType": {
      "type": "string",
      "enum": [
        "podstawowy",
        "dodatkowy"
      ]
    },
    "JobBillingType": {
      "type": "string",
      "enum": [
        "hourly",
        "fixed",
        "m2",
        "mb"
      ]
    },
    "JobRiskFlag": {
      "type": "string",
      "enum": [
        "none",
        "delay",
        "overbudget",
        "scope_change"
      ]
    },
    "JobPriority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ]
    },
    "JobStage": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "status",
        "plannedRevenueNet"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "jobId": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "$ref": "#/definitions/JobStageType"
        },
        "status": {
          "$ref": "#/definitions/JobStageStatus"
        },
        "plannedRevenueNet": {
          "type": "number",
          "minimum": 0
        },
        "plannedCostNet": {
          "type": "number",
          "minimum": 0
        },
        "actualRevenueNet": {
          "type": "number",
          "minimum": 0
        },
        "actualCostNet": {
          "type": "number",
          "minimum": 0
        },
        "revenueSharePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "startPlanned": {
          "type": "string"
        },
        "endPlanned": {
          "type": "string"
        },
        "startActual": {
          "type": "string"
        },
        "endActual": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "plannedLaborHours": {
          "type": "number",
          "minimum": 0
        },
        "assignedTeams": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assignedStartTime": {
          "type": "string"
        },
        "assignedLocation": {
          "type": "string"
        },
        "assignedNotes": {
          "type": "string"
        },
        "billingType": {
          "$ref": "#/definitions/JobBillingType"
        },
        "billingRate": {
          "type": "number",
          "minimum": 0
        },
        "plannedLaborCost": {
          "type": "number",
          "minimum": 0
        },
        "actualLaborHours": {
          "type": "number",
          "minimum": 0
        },
        "actualLaborCost": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "JobStagePostPayload": {
      "type": "object",
      "required": [
