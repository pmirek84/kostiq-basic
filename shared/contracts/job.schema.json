          "$ref": "#/definitions/JobRiskFlag"
        },
        "riskComment": {
          "type": "string"
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JobStagePostPayload"
          }
        }
      },
      "additionalProperties": true
    },
    "JobBatchImportPayload": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/JobPostPayload"
          }
        }
      },
      "additionalProperties": false
    },
    "PaginationMetadata": {
      "type": "object",
      "required": [
        "page",
        "limit",
        "total",
        "totalPages",
        "hasMore"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
