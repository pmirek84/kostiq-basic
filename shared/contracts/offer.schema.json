{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OfferContractSchema",
  "description": "Unified JSON schema for Offer domain entity, templates, POST/PATCH payloads, batch imports, and CAS concurrency control.",
  "definitions": {
    "OfferRecordKind": {
      "type": "string",
      "enum": [
        "offer",
        "template"
      ]
    },
    "OfferStatus": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "accepted",
        "rejected",
        "converted",
        "archived"
      ]
    },
    "OfferVatRate": {
      "type": "number",
      "enum": [
        0,
        8,
        23
      ]
    },
    "OfferDiscountType": {
      "type": "string",
      "enum": [
        "none",
        "percent",
        "amount"
      ]
    },
    "RentalItem": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "quantity",
        "duration",
        "unitPrice",
        "totalPrice"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "quantity": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "unitPrice": {
          "type": "number",
          "minimum": 0
        },
        "totalPrice": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "OfferCostBreakdown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "material_cost": {
          "type": "number",
          "minimum": 0
        },
        "assembly_cost": {
          "type": "number",
          "minimum": 0
        },
        "transport_cost": {
          "type": "number",
          "minimum": 0
        },
        "equipment_rental_cost": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "OfferDocument": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "number",
        "recordKind",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "string",
          "minLength": 1
        },
        "recordKind": {
          "$ref": "#/definitions/OfferRecordKind"
        },
        "clientId": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/OfferStatus"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "validUntil": {
          "type": "string"
        },
        "materialsCost": {
          "type": "number",
          "minimum": 0
        },
        "laborCost": {
          "type": "number",
          "minimum": 0
        },
        "totalCost": {
          "type": "number",
          "minimum": 0
        },
        "totalNet": {
          "type": "number",
          "minimum": 0
        },
        "subtotalNet": {
          "type": "number",
          "minimum": 0
        },
        "discountAmount": {
          "type": "number",
          "minimum": 0
        },
        "vatAmount": {
          "type": "number",
          "minimum": 0
        },
        "totalGross": {
          "type": "number",
          "minimum": 0
        },
        "vatRate": {
          "$ref": "#/definitions/OfferVatRate"
        },
        "discountType": {
          "$ref": "#/definitions/OfferDiscountType"
        },
        "discountValue": {
          "type": "number",
          "minimum": 0
        },
        "rentalItems": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RentalItem"
          }
        },
        "costBreakdown": {
          "$ref": "#/definitions/OfferCostBreakdown"
        },
        "settings": {
          "type": "object"
        },
        "title": {
          "type": "string"
        },
        "scopeOfWork": {
          "type": "array"
        },
        "customMaterials": {
          "type": "object"
        },
        "notes": {
          "type": "array"
        },
        "printLayout": {
          "type": "string"
        },
        "printMode": {
          "type": "string"
        },
        "offerTemplateType": {
          "type": "string"
        },
        "editVersion": {
          "type": "integer",
          "minimum": 1
        },
        "isActive": {
          "type": "boolean"
        }
      }
    },
    "OfferPostPayload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "number": {
          "type": "string"
        },
        "recordKind": {
          "$ref": "#/definitions/OfferRecordKind"
        },
        "clientId": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/OfferStatus"
        },
        "validUntil": {
          "type": "string"
        },
        "materialsCost": {
          "type": "number",
          "minimum": 0
        },
        "laborCost": {
          "type": "number",
          "minimum": 0
        },
        "totalCost": {
          "type": "number",
          "minimum": 0
        },
        "totalNet": {
          "type": "number",
          "minimum": 0
        },
        "subtotalNet": {
          "type": "number",
          "minimum": 0
        },
        "discountAmount": {
          "type": "number",
          "minimum": 0
        },
        "vatAmount": {
          "type": "number",
          "minimum": 0
        },
        "totalGross": {
          "type": "number",
          "minimum": 0
        },
        "vatRate": {
          "$ref": "#/definitions/OfferVatRate"
        },
        "discountType": {
          "$ref": "#/definitions/OfferDiscountType"
        },
        "discountValue": {
          "type": "number",
          "minimum": 0
        },
        "rentalItems": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RentalItem"
          }
        },
        "costBreakdown": {
          "$ref": "#/definitions/OfferCostBreakdown"
        },
        "settings": {
          "type": "object"
        },
        "title": {
          "type": "string"
        },
        "scopeOfWork": {
          "type": "array"
        },
        "customMaterials": {
          "type": "object"
        },
        "notes": {
          "type": "array"
        },
        "printLayout": {
          "type": "string"
        },
        "printMode": {
          "type": "string"
        },
        "offerTemplateType": {
          "type": "string"
        },
        "idempotencyKey": {
          "type": "string"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "editVersion"
            ]
          },
          {
            "required": [
              "expectedVersion"
            ]
          }
        ]
      }
    },
    "OfferPatchPayload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "expectedVersion": {
          "type": "integer",
          "minimum": 1
        },
        "clientId": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/OfferStatus"
        },
        "validUntil": {
          "type": "string"
        },
        "materialsCost": {
          "type": "number",
          "minimum": 0
        },
        "laborCost": {
          "type": "number",
          "minimum": 0
        },
        "totalCost": {
          "type": "number",
          "minimum": 0
        },
        "totalNet": {
          "type": "number",
          "minimum": 0
        },
        "subtotalNet": {
          "type": "number",
          "minimum": 0
        },
        "discountAmount": {
          "type": "number",
          "minimum": 0
        },
        "vatAmount": {
          "type": "number",
          "minimum": 0
        },
        "totalGross": {
          "type": "number",
          "minimum": 0
        },
        "vatRate": {
          "$ref": "#/definitions/OfferVatRate"
        },
        "discountType": {
          "$ref": "#/definitions/OfferDiscountType"
        },
        "discountValue": {
          "type": "number",
          "minimum": 0
        },
        "rentalItems": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RentalItem"
          }
        },
        "costBreakdown": {
          "$ref": "#/definitions/OfferCostBreakdown"
        },
        "settings": {
          "type": "object"
        },
        "title": {
          "type": "string"
        },
        "scopeOfWork": {
          "type": "array"
        },
        "customMaterials": {
          "type": "object"
        },
        "notes": {
          "type": "array"
        },
        "printLayout": {
          "type": "string"
        },
        "printMode": {
          "type": "string"
        },
        "offerTemplateType": {
          "type": "string"
        }
      },
      "required": [
        "expectedVersion"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "editVersion"
            ]
          },
          {
            "required": [
              "number"
            ]
          },
          {
            "required": [
              "recordKind"
            ]
          }
        ]
      }
    },
    "OfferBatchImportPayload": {
      "type": "object",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/OfferBatchImportItem"
          }
        }
      }
    },
    "OfferBatchImportItem": {
      "type": "object",
      "required": [
        "id",
        "number",
        "recordKind",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "string",
          "minLength": 1
        },
        "recordKind": {
          "$ref": "#/definitions/OfferRecordKind"
        },
        "status": {
          "$ref": "#/definitions/OfferStatus"
        },
        "clientId": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": "string"
        },
        "validUntil": {
          "type": "string"
        },
        "materialsCost": {
          "type": "number",
          "minimum": 0
        },
        "laborCost": {
          "type": "number",
          "minimum": 0
        },
        "totalCost": {
          "type": "number",
          "minimum": 0
        },
        "totalNet": {
          "type": "number",
          "minimum": 0
        },
        "subtotalNet": {
          "type": "number",
          "minimum": 0
        },
        "discountAmount": {
          "type": "number",
          "minimum": 0
        },
        "vatAmount": {
          "type": "number",
          "minimum": 0
        },
        "totalGross": {
          "type": "number",
          "minimum": 0
        },
        "vatRate": {
          "$ref": "#/definitions/OfferVatRate"
        },
        "discountType": {
          "$ref": "#/definitions/OfferDiscountType"
        },
        "discountValue": {
          "type": "number",
          "minimum": 0
        },
        "rentalItems": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RentalItem"
          }
        },
        "costBreakdown": {
          "$ref": "#/definitions/OfferCostBreakdown"
        },
        "settings": {
          "type": "object"
        },
        "title": {
          "type": "string"
        },
        "scopeOfWork": {
          "type": "array"
        },
        "customMaterials": {
          "type": "object"
        },
        "notes": {
          "type": "array"
        },
        "printLayout": {
          "type": "string"
        },
        "printMode": {
          "type": "string"
        },
        "offerTemplateType": {
          "type": "string"
        },
        "editVersion": {
          "type": "integer",
          "minimum": 1
        },
        "isActive": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      }
    }
  }
}
